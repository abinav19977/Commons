{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "commons",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "commons-production",
      "database_id": "1c8728aa-e19b-4cf6-ae04-00cece3b7f4b"
    }
  ]
}
